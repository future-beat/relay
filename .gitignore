# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Environment — never commit local env files in any format
.env
.env.*
!.env.example

# Local data
*.db
*.sqlite3
# SQLite WAL sidecars — *.db does not cover them, and they appear the moment the
# app runs locally in WAL mode.
*.db-shm
*.db-wal

# Local captures — browser exports of the dashboard taken during checkpoints.
# The repo ships no PDF assets, so the glob costs nothing and survives the next one.
*.pdf

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editors
.DS_Store
.idea/
.vscode/
eval_results/
