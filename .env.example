# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
RELAY_MODEL=claude-sonnet-5
RELAY_DB_PATH=relay.db
RELAY_MAX_AGENT_STEPS=10
RELAY_MAX_RUN_COST_USD=0.50
RELAY_MCP_ALLOW_WRITES=false  # set to true to opt into MCP write tools

# Security perimeter (phase 1). Auth fails closed, so local dev needs both keys set.
# Generate a fresh value for each — a literal shipped here is a literal deployed:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_API_KEY=
RELAY_DEMO_KEY=
RELAY_MAX_DAILY_COST_USD=5.0
RELAY_TRUST_PROXY=false

# How long shutdown waits for in-flight SSE runs before closing the database.
# Keep it under uvicorn's --timeout-graceful-shutdown, which is under fly.toml's kill_timeout.
RELAY_SHUTDOWN_DRAIN_SECONDS=5.0

# Optional: export OpenTelemetry traces (spans are no-op when unset)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
